# ESP32-S3 with 16 MB flash + 8 MB PSRAM (N16R8 class modules).
# Many DevKitC-1 boards use octal PSRAM wiring — quad mode causes a boot loop.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# Keep ordinary malloc() internal by default. Production code that intentionally uses PSRAM
# allocates it through heap_caps_malloc(..., MALLOC_CAP_SPIRAM).
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# TRY_ALLOCATE_WIFI_LWIP is intentionally omitted: ESP-IDF disables that optimization when
# CONFIG_SPIRAM_IGNORE_NOTFOUND is enabled.
